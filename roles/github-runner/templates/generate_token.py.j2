#!/usr/bin/env python3
import jwt
import time
import requests
import sys

# GitHub App credentials
APP_ID = "{{ secrets.git.runner_client_id }}"
INSTALLATION_ID = "{{ secrets.git.runner_install_id }}"
PRIVATE_KEY = """{{ secrets.git.runner_registration_pem }}"""

def generate_jwt():
    """Generate a JWT for GitHub App authentication"""
    payload = {
        'iat': int(time.time()),
        'exp': int(time.time()) + (10 * 60),  # 10 minutes
        'iss': APP_ID
    }

    return jwt.encode(payload, PRIVATE_KEY, algorithm='RS256')

def get_installation_token():
    """Get an installation access token"""
    jwt_token = generate_jwt()

    headers = {
        'Authorization': f'Bearer {jwt_token}',
        'Accept': 'application/vnd.github.v3+json'
    }

    url = f'https://api.github.com/app/installations/{INSTALLATION_ID}/access_tokens'

    response = requests.post(url, headers=headers)

    if response.status_code != 201:
        sys.stderr.write(f"Error: {response.status_code}\n")
        sys.stderr.write(f"{response.text}\n")
        sys.exit(1)

    return response.json()['token']

def get_registration_token(installation_token, org):
    """Get a runner registration token"""
    headers = {
        'Authorization': f'token {installation_token}',
        'Accept': 'application/vnd.github.v3+json'
    }

    url = f'https://api.github.com/orgs/{org}/actions/runners/registration-token'

    response = requests.post(url, headers=headers)

    if response.status_code != 201:
        sys.stderr.write(f"Error: {response.status_code}\n")
        sys.stderr.write(f"{response.text}\n")
        sys.exit(1)

    return response.json()['token']

if __name__ == '__main__':
    try:
        installation_token = get_installation_token()
        registration_token = get_registration_token(installation_token, '{{ secrets.git.runner_org_id }}')
        print(registration_token)
    except Exception as e:
        sys.stderr.write(f"Error: {str(e)}\n")
        sys.exit(1)
